common:hcu_base --config=rocm_base
common:hcu_base --repo_env=ROCM_PATH=/opt/dtk
common:hcu_base --repo_env=TF_ROCM_HCUGPU_TARGETS="gfx906,gfx926,gfx928,gfx936,gfx938"
common:hcu_base --action_env=TF_ROCM_CLANG="1"
common:hcu_base --action_env=CLANG_COMPILER_PATH="/opt/dtk/aillvm/bin/clang"

# Used by @xla//build_tools/hcu:parallel_gpu_execute to find rocminfo runfiles.
common:hcu_base --legacy_external_runfiles=true

common:hcu --config=hcu_base
common:hcu --copt=-DXLA_ROCM_ENABLE_HCU=1
common:hcu --repo_env=HCU_ENABLED=1

# -----------------------------------------------------------------------------
# Test execution.
# -----------------------------------------------------------------------------
test:hcu_test --test_timeout=920,2400,7200,9600
test:hcu_test --test_output=errors
test:hcu_test --test_verbose_timeout_warnings
test:hcu_test --test_env=TF_TESTS_PER_GPU=1

# Single-GPU: parallel_gpu_execute flocks one HCU per test and exports
# HIP_VISIBLE_DEVICES, so tests can run concurrently across devices.
build:ci_single_gpu --run_under=//build_tools/hcu:parallel_gpu_execute
build:ci_single_gpu --flaky_test_attempts=3

# Multi-GPU: must NOT use parallel_gpu_execute -- it pins each test to a single device
build:ci_multi_gpu --test_env=XLA_FLAGS="--xla_gpu_force_compilation_parallelism=16 --xla_gpu_enable_llvm_module_compilation_parallelism=true"
build:ci_multi_gpu --test_env=NCCL_MAX_NCHANNELS=1
build:ci_multi_gpu --test_sharding_strategy=disabled
build:ci_multi_gpu --flaky_test_attempts=3
build:ci_multi_gpu --experimental_guard_against_concurrent_changes
build:ci_multi_gpu --test_env=HIP_VISIBLE_DEVICES=0,1,2,3

# align with rocm upstream
test:hcu_sgpu -- \
//xla/... \
-//xla/tests:iota_test_amdgpu_any \
-//xla/backends/gpu/collectives:gpu_clique_key_test \
-//xla/service:collective_ops_utils_test \
-//xla/service:collective_pipeliner_test \
-//xla/service:collective_permute_cycle_test \
-//xla/service:batched_gather_scatter_normalizer_test \
-//xla/service:all_reduce_simplifier_test \
-//xla/service:all_gather_simplifier_test \
-//xla/service:reduce_scatter_decomposer_test \
-//xla/service:reduce_scatter_reassociate_test \
-//xla/service:reduce_scatter_combiner_test \
-//xla/service:scatter_simplifier_test \
-//xla/service:sharding_propagation_test \
-//xla/service:sharding_remover_test \
-//xla/service:p2p_schedule_preparation_test \
-//xla/pjrt/distributed:topology_util_test \
-//xla/pjrt/distributed:client_server_test \
-//xla/stream_executor/rocm:roctracer_wrapper \
-//xla/backends/profiler/gpu:rocm_collector \
-//xla/backends/profiler/gpu:rocm_tracer \
-//xla/backends/profiler/gpu:rocm_collector_test \
-//xla/backends/profiler/gpu:rocm_tracer_test

# align with rocm upstream
test:hcu_mgpu -- \
//xla/backends/gpu/tests:collective_ops_e2e_test \
//xla/tests:collective_ops_test \
//xla/backends/gpu/tests:collective_pipeline_parallelism_test \
//xla/backends/gpu/tests:replicated_io_feed_test \
//xla/backends/gpu/collectives:gpu_clique_key_test \
//xla/backends/gpu/runtime:all_reduce_test \
//xla/service:collective_ops_utils_test \
//xla/service:collective_pipeliner_test \
//xla/service:collective_permute_cycle_test \
//xla/service:batched_gather_scatter_normalizer_test \
//xla/service:all_reduce_simplifier_test \
//xla/service:all_gather_simplifier_test \
//xla/service:reduce_scatter_decomposer_test \
//xla/service:reduce_scatter_reassociate_test \
//xla/service:reduce_scatter_combiner_test \
//xla/service:scatter_simplifier_test \
//xla/service:sharding_propagation_test \
//xla/service:sharding_remover_test \
//xla/service:p2p_schedule_preparation_test \
//xla/tools/multihost_hlo_runner:functional_hlo_runner_test \
//xla/pjrt/distributed:topology_util_test \
//xla/pjrt/distributed:client_server_test
