+    @gluon.jit
+    def issue_global_load_x(self, load_idx, pred=1):
+        cfg = self.cfg
+        BLOCK_K_PACKED_X: gl.constexpr = cfg.BLOCK_K // cfg.DIV_FACTOR_X
+        BLOCK_K_SCALE: gl.constexpr = cfg.BLOCK_K // cfg.SCALE_BLOCK
