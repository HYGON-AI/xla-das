+  std::lock_guard lg(mut);
+  if (gsanEnsureInit() != 0)
+    return -1;
+  CUresult err = ensureContext(device);
+  if (err != CUDA_SUCCESS) {
+    printCUDAError(err);
+    return -1;
+  }
