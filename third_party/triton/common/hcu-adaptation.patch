+@triton.jit
+def wait_eq_sys(barrier_ptr, value):
+    tid = thread_idx(axis=0)
+    if tid == 0:
+        while load_acquire_system(barrier_ptr) != value:
+            pass
+
+    tl.debug_barrier()
