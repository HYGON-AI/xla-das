+        outDimNames);
+  case MmacLayout::TRANSPOSE:
+    return LinearLayout(
+        {{kRegister, {{0, 4}, {0, 8}}},
+         {kLane, {{1, 0}, {2, 0}, {4, 0}, {8, 0}, {0, 1}, {0, 2}}}},
