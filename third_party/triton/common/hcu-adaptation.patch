+        # Apply causal masking if required
+        if IS_CAUSAL:
+            sequence_extension = (
+                QUERY_SEQ_LEN - 1 - qk_row_offsets // ONE_QUERY_GROUP_SIZE_POW2
+            )
+            causal_mask = (
+                sequence_extension[:, None] + qk_column_offsets[None, :]
+                < context_length
+            )
+        else:
+            causal_mask = qk_column_offsets[None, :] < context_length
