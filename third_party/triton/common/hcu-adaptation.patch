+    auto funcs = mod.getOps<LLVM::LLVMFuncOp>();
+    auto kernelIt = llvm::find_if(
+        funcs, [](LLVM::LLVMFuncOp func) { return triton::isKernel(func); });
+    if (kernelIt == funcs.end())
+      return;
+    LLVM::LLVMFuncOp kernel = *kernelIt;
