+def wrap_handle_tensordesc(launcher, signature, tensordesc_metadata):
+    """
+    Wrap a kernel launcher to expand tensordesc args (including nested tuples)
+    into the structure expected by the generated C launcher ParseTuple format.
+
+    Nested non-tensordesc tuples stay nested (matching format `(OO)...`).
+    Tensordesc values are decomposed into leaves; inside a tuple those leaves
+    stay inside that nested tuple (matching expand_signature).
+    """
+
+    sig = tuple(signature.values())
+    tensordesc_paths = find_paths_if(sig, lambda _, x: isinstance(x, str) and x.startswith("tensordesc"))
+    if not tensordesc_paths:
+        return launcher
+
+    if not tensordesc_metadata:
+        tensordesc_metadata = [None] * len(tensordesc_paths)
+    else:
+        assert len(tensordesc_metadata) == len(tensordesc_paths)
+
+    def _expand(arg, s, meta_idx, base_args):
+        if isinstance(s, str) and s.startswith("tensordesc"):
+            out = make_tensordesc_arg(arg, tensordesc_metadata[meta_idx[0]], base_args)
+            meta_idx[0] += 1
+            return out  # list of leaf values
+        if isinstance(s, tuple):
+            out = []
+            for a, ss in zip(arg, s):
+                piece = _expand(a, ss, meta_idx, base_args)
+                if isinstance(piece, list):
+                    out.extend(piece)
+                else:
+                    out.append(piece)
+            return tuple(out)
+        return arg
+
+    def inner(*args):
+        meta_args = args[:len(_BASE_ARGS_FORMAT)]
+        raw_kernel_args = args[len(_BASE_ARGS_FORMAT):]
+        meta_idx = [0]
+        final_args = []
+        for arg, s in zip(raw_kernel_args, sig):
+            piece = _expand(arg, s, meta_idx, meta_args)
+            if isinstance(piece, list):
+                # Top-level tensordesc → flatten into argv (like AMD).
+                final_args.extend(piece)
+            else:
+                final_args.append(piece)
+        return launcher(*meta_args, *final_args)
+
+    return inner
+
