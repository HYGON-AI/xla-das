+std::unique_ptr<OperationPass<ModuleOp>>
+createConvertTritonHCUToLLVMPass(StringRef targetArch, bool ftz) {
+  return std::make_unique<ConvertTritonHCUToLLVM>(targetArch, ftz);
+}
