+import torch
+os.environ["TRITON_HCUTUNE"] = "1"
+import triton
+import triton.language as tl
+
+def do_bench(kernel_call, quantiles):
+    return triton.testing.do_bench(kernel_call, quantiles=quantiles, warmup=1, rep=1)
+
