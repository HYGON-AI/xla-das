+  return [opId](PatternRewriter &rewriter, tt::ExternElementwiseOp op) {
+    if (!hasFp32Signature(op, 1))
+      return Value();
+    return fpsanUnaryTagged(rewriter, op.getLoc(), op.getOperand(0), opId);
+  };
