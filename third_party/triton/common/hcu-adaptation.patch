+
+    torch.manual_seed(0)
+    bsz = 1
+    query_length = 1
+    num_kv_heads = 1
+    query_group_size = 8
+    num_query_heads = num_kv_heads * query_group_size
+    head_size = 128
+    kv_block_size = 16
+    num_blocks = 2
+
+    query = torch.randn(
+        (bsz * query_length, num_query_heads, head_size),
+        device="cuda",
+        dtype=torch.bfloat16,
+    )
+    output = torch.empty_like(query)
+
+    x = 16 // torch.tensor([], dtype=torch.bfloat16).element_size()
+    key_cache = torch.randn(
+        (num_blocks, num_kv_heads, head_size // x, kv_block_size, x),
+        device="cuda",
+        dtype=torch.bfloat16,
+    )
+    value_cache = torch.randn(
+        (num_blocks, num_kv_heads, head_size, kv_block_size),
+        device="cuda",
+        dtype=torch.bfloat16,
+    )
+
+    context_lengths = torch.tensor([kv_block_size], device="cuda", dtype=torch.int32)
+    block_tables = torch.tensor([[0]], device="cuda", dtype=torch.int32)
+
+    softmax_scale = float(head_size ** -0.5)
+    pa_decode_gluon(
+        output=output,
+        query=query,
+        key_cache=key_cache,
+        value_cache=value_cache,
+        context_lengths=context_lengths,
+        block_tables=block_tables,
+        softmax_scale=softmax_scale,
+        query_length=query_length,
+        max_context_partition_num=1,
