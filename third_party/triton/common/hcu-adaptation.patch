+namespace {
+struct PartitionLoops
+    : triton::gpu::impl::TritonGPUPartitionLoopsHCUBase<PartitionLoops> {
+  using TritonGPUPartitionLoopsHCUBase::TritonGPUPartitionLoopsHCUBase;
+
+  void runOnOperation() override;
+};
