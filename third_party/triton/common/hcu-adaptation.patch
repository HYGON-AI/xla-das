+#ifndef TRITON_TRITONGPU_TRANSFORMS_ABARRIER_ID_MANAGER_H_
+#define TRITON_TRITONGPU_TRANSFORMS_ABARRIER_ID_MANAGER_H_
+
+#include "mlir/Dialect/SCF/IR/SCF.h"
