+// Convert Ocp Fp8/Bf8 to Fp32 on HCU
+template <typename convertOp>
+static SmallVector<Value>
+HCU_cvtPkUpcastFromFp8(Location loc, ConversionPatternRewriter &rewriter,
+                        Value v0, Value v1) {
+  auto b = TritonLLVMOpBuilder(loc, rewriter);
+  auto fp8x4VecTy = vec_ty(i8_ty, 4);
+  Value fp8x4Vec = b.undef(fp8x4VecTy);
+  auto idx0 = b.i32_val(0);
+  auto idx1 = b.i32_val(1);
+  fp8x4Vec = b.insert_element(fp8x4VecTy, fp8x4Vec, v0, idx0);
+  fp8x4Vec = b.insert_element(fp8x4VecTy, fp8x4Vec, v1, idx1);
+  auto i32v = b.bitcast(fp8x4Vec, i32_ty);
+
+  auto resType = i32_ty;
+  auto dstType = f32_ty;
+  if constexpr (std::is_same_v<convertOp, ROCDL::HCUCvtPkF32Fp8Op> ||
+                std::is_same_v<convertOp, ROCDL::HCUCvtPkF32Bf8Op>) {
+    resType = i64_ty;
+    dstType = f32_ty;
+  } else {
+    assert(false && "Unsupported conversion from fp16|bf16 to fp8/bf8");
+    resType = i32_ty;
+    dstType = f16_ty;
+  }
+  Value select = b.false_val();
+  auto result = convertOp::create(rewriter, loc, resType, i32v, select);
+  auto retVecTy = vec_ty(dstType, 2);
+  auto retVec = b.bitcast(result, retVecTy);
+  SmallVector<Value> ret(2);
+
+
+  ret[0] = b.extract_element(dstType, retVec, idx0);
+  ret[1] = b.extract_element(dstType, retVec, idx1);
+  return ret;
+}
+
+// Convert Fp32 to OCP Fp8/Bf8 on HCU
+template <typename convertOp>
+static SmallVector<Value>
+HCU_cvtPkDowncastToFp8(Location loc, ConversionPatternRewriter &rewriter,
+                        Value v0, Value v1) {
+  auto b = TritonLLVMOpBuilder(loc, rewriter);
+  Value i32Old = b.undef(i32_ty);
+  Value select = b.false_val();
+
+  Value result;
+  if constexpr (std::is_same_v<convertOp, ROCDL::HCUCvtPkFp8F32Op> ||
+                std::is_same_v<convertOp, ROCDL::HCUCvtPkBf8F32Op>) {
+    result = convertOp::create(rewriter, loc, i32_ty, v0, v1, i32Old, select);
+  } else {
+    assert(false && "Unsupported conversion from fp16|bf16 -> fp8/bf8");
+  }
+  auto fp8x4VecTy = vec_ty(i8_ty, 4);
+  auto fp8x4Vec = b.bitcast(result, fp8x4VecTy);
+  SmallVector<Value> ret(2);
+  auto idx0 = b.i32_val(0);
+  auto idx1 = b.i32_val(1);
+  ret[0] = b.extract_element(i8_ty, fp8x4Vec, idx0);
+  ret[1] = b.extract_element(i8_ty, fp8x4Vec, idx1);
+  return ret;
+}
