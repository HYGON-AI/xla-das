+class PruneConfigLoader:
+    def __init__(self, configs, world_size=1, rank=0):
+        self.configs = configs
+        self.indices = _split_list_balanced(len(self.configs), world_size)[rank]
+
+    def __iter__(self):
+        for i in self.indices:
+            yield self.configs[i]
