+  // Sweep cross-pipeline pairs only.  Placement choice mirrors
+  // analyzePipelineDependencies (dist == 1 → dst, dist > 1 → dst - 1).
+  for (int i = 0; i < K; i++) {
+    for (int j = 0; j < M; j++) {
