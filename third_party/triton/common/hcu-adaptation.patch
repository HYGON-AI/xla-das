+    @staticmethod
+    def get_tensor_physical_size(t) -> int: 
+        if t.numel() == 0:
+            return 0
+
+        offset = sum((size_i - 1) * stride_i for size_i, stride_i in zip(t.shape, t.stride()))
+        elements = offset + 1
+        return elements * t.element_size()
