+            lib_dir = os.path.join(os.path.dirname(_rocm_sdk_core.__file__), "lib")
+            if os.path.isdir(lib_dir):
+                triton.knobs.proton.rocprofiler_sdk_lib_path = lib_dir
+        except ImportError:
+            pass
+
+
+_ensure_rocprofiler_sdk_env()
+
