+    # Compare results
+    torch.testing.assert_close(x_q_triton, x_q_torch, rtol=0, atol=1)
+    torch.testing.assert_close(x_s_triton, x_s_torch, rtol=1e-3, atol=1e-3)
+
+# Test cases for w8a8_block_int8_matmul
+MATMUL_TEST_CASES = [
+    # M, K, N, block_size  # frequency
