+@triton.jit
+def wait_cas_sys(barrier_ptr, cmp_ptr, value):
+    tid = thread_idx(axis=0)
+    if tid == 0:
+        while atom_cas_acquire_relaxed_system(barrier_ptr, cmp_ptr, value) == value:
+            pass
+
+    tl.debug_barrier()
