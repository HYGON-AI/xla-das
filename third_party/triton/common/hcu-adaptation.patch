-        shape=list(input_tensor.shape),
-        strides=list(input_tensor.stride()),
-        block_shape=input_block_shape,
-        layout=input_layout,
-        padding="zero",
-        element_strides=[1, stride, stride, 1],
-        pixel_box_lower_corner=[-padding, -padding],
-        pixel_box_upper_corner=[upper_h, upper_w],
