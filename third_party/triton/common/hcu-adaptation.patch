+              // Phase 1: T32-35, T44-47, T52-55, T56-59
+              // Phase 2: T4-7,   T8-11,  T16-19, T28-31
+              // Phase 3: T36-39, T40-43, T48-51, T60-63
+              // phaseIdx is a linear layout on the laneIdx:
+              // phase[0] = t[5]
