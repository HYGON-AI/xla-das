@@ -0,0 +1,29 @@
+import subprocess
+import sys
+from pathlib import Path
+
+import pytest
+
+
+TEST_PATH = Path(__file__).resolve().parent
+SRC_HOME = TEST_PATH.parents[2]
+
+SUBPROCESS_CASES = [
