-  out.insert(out.end(), value.begin(), value.end());
+  const auto offset = out.size();
+  out.resize(offset + size);
+  std::memcpy(out.data() + offset, value.data(), size);
 }
 
 void MsgPackWriter::packArray(uint32_t size) {
