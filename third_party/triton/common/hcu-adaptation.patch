+def builtin_libdevice_unary_kernel(
+    x_ptr,
+    builtin_ptr,
+    libdevice_ptr,
+    n_elements,
+    OP: tl.constexpr,
+    BLOCK_SIZE: tl.constexpr,
+):
+    offsets = tl.program_id(0) * BLOCK_SIZE + tl.arange(0, BLOCK_SIZE)
+    mask = offsets < n_elements
+    x = tl.load(x_ptr + offsets, mask=mask)
