+                plot_name = str("geglu-performance_" + dataType + "_M" + str(args.M_start) + "_N" + str(args.N_start) +
+                                "-" + str(args.N_end) + "-" + str(args.N_step) + "_mode_" + mode)
+            mn_args['mode'] = mode
+            mn_args['dtype'] = arg_to_torch_dtype[dataType]
+
+            if args.Te:
