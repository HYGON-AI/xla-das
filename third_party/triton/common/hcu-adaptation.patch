+        requestedNumDevices > static_cast<int>(gsan::kMaxGPUs)) {
+      PyErr_Format(PyExc_ValueError, "num_devices must be in [1, %zu], got %d",
+                   static_cast<size_t>(gsan::kMaxGPUs), requestedNumDevices);
+      return nullptr;
