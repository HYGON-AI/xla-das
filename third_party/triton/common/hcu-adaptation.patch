+def _create_tuple(k):
+    s = k[1:-1]
+    entries = s.split(", ")
+    ret = []
+    for e in entries:
+        if e[0] == "'" or e[0] == '"':
+            ret.append(e[1:-1])
+        else:
+            ret.append(eval(e))
+    ret_t = tuple(ret)
+    return ret_t
