+  tt.func @back_to_back_for_then_flat(
+      %lb: i32, %ub: i32, %step: i32,
+      %acc: tensor<256x256xf32, #b2bf_mma>,
+      %ptr: tensor<256x64x!tt.ptr<f16>, #b2bf_blocked>,
