+namespace mlir::triton::HCU {
+void populateDsReadMToLLVMPatterns(LLVMTypeConverter &typeConverter,
+                                   RewritePatternSet &patterns,
+                                   PatternBenefit benefit) {
+  patterns.add<HCUDsReadMConversion>(typeConverter, benefit);
+}
