+
+        if hasattr(arg, "ptr_range"):
+            return arg.ptr_range() <= 2**32 - 8
+        if isinstance(arg, torch.Tensor) and hasattr(arg, "untyped_storage"):
+            return HIPBackend.get_tensor_physical_size(arg) <= 2**32 - 8
+        return False
