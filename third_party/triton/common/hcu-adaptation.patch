-    # Ci need not be divisible by BLOCK_K: the last channel block is partial and
-    # TMA zero-fills out-of-bounds, so the MMA result remains correct.
-    BLOCK_M = 256
-    BLOCK_N = 256
-    BLOCK_K = 64
-    GROUP_SIZE_M = 4
