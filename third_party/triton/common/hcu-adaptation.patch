+
+        def stream(self, stream):
+            self.stream_args.append(stream)
+            return stream
+
+        def default_stream(self, device):
+            self.default_stream_arg = device
+            return self
+
+        def __enter__(self):
+            return self
+
+        def __exit__(self, exc_type, exc_value, traceback):
+            return False
+
