+#include "TritonAMDGPUToLLVM/TargetUtils.h"
+#include "llvm/ADT/DenseMap.h"
+#include <algorithm>
+#include "llvm/TargetParser/TargetParser.h"
+
+namespace mlir::triton::AMD {
