+static SmallVector<Value>
+Fp8E5M2_to_Bf16_SW(Location loc, ConversionPatternRewriter &rewriter,
+                   const SmallVector<Value> &v) {
+  return OcpF8_to_Bf16_SW<Float8E5M2Type>(loc, rewriter, v);
+}
