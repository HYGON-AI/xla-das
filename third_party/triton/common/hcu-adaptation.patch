+  void runOnOperation() override {
+    ModuleOp mod = getOperation();
+    auto countAttr = mod->getAttrOfType<IntegerAttr>(
+        triton::nvidia_gpu::kWSClusterBarrierCountAttrName);
+    if (!countAttr || countAttr.getInt() == 0)
+      return;
