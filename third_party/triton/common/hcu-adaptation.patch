+__int_or_none_config_args__ = ["maxnreg"]
+__bool_config_args__ = ["enable_warp_specialization"]
+__config_args__ = (
+    ["pre_hook"]
+    + __int_config_args__
+    + __bool_config_args__
+    + __int_or_none_config_args__
+)
+__skip_config_args__ = ["enable_persistent"]
