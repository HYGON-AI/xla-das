+                                                                      SUBTILE_LEN // cfg.DIV_FACTOR_W,
+                                                                      0).load(layout=cfg.dot_layout_w)
+
+        if cfg.WITH_X_MX_SCALE:
+            x_scale_buffer_slice = self.x_scale_buffer.index(wmma_idx % cfg.NUM_BUFFERS)
+            if cfg.SCALE_PRESHUFFLE:
