+@dataclass(frozen=True, slots=True)
+class PreparedCase:
+    batch_size: int
+    local_rank: int
+    x: torch.Tensor
+    w: Tensor
+    w_scale: Tensor
+    bias: torch.Tensor
+    ragged_metadata: RaggedTensorMetadata
+    gather_indx: torch.Tensor
+    fused_activation: FusedActivation
+    x_scale: torch.Tensor
+    y_scale: torch.Tensor
