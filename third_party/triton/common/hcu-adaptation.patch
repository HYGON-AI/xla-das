+def fp4_map(values: torch.Tensor) -> torch.Tensor:
+    fp4_e2m1_map = [0.0, 0.5, 1.0, 1.5, 2.0, 3.0, 4.0, 6.0,
+                    -0.0, -0.5, -1.0, -1.5, -2.0, -3.0, -4.0, -6.0]
