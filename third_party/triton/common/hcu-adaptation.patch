+
+    @gluon.jit
+    def issue_subtile_local_loads(self, wmma_idx, subtile_start_idx: gl.constexpr):
+        cfg = self.cfg
+        NUM_SUBTILES_K: gl.constexpr = cfg.NUM_SUBTILES[2]
