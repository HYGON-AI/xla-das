+
+def get_list_hash(l):
+    s = "|".join(l)
+    return hashlib.sha256(s.encode("utf-8")).hexdigest()
+
+
+def get_string_hash(s):
+    return hashlib.sha256(s.encode("utf-8")).hexdigest()
