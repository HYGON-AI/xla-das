-    if constexpr (std::is_same_v<FPType, Float16Type>) {
-      return llvm::APFloat::IEEEhalf();
-    }
-    if constexpr (std::is_same_v<FPType, BFloat16Type>) {
-      return llvm::APFloat::BFloat();
