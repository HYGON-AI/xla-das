+    // Even with warp-uniform threadPred, hasOther must keep branch predication.
+    // CHECK: %[[PRED:.*]] = llvm.and {{.*}} : i1
+    // CHECK: llvm.cond_br %[[PRED]], ^[[LOAD_BLOCK:bb[0-9]+]]
