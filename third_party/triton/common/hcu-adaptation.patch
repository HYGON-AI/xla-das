+    Value newInd = ConvertLayoutOp::create(rewriter, op.getLoc(), newType,
+                                           adaptor.getXOffsets());
+    rewriter.replaceOpWithNewOp<triton::DescriptorGatherOp>(
+        op, getTypeConverter()->convertType(op.getType()), adaptor.getDesc(),
+        newInd, adaptor.getYOffset());
+    return success();
+  }
+};
