+    output_group_idx_in_len = output_group_offsets_mtp % ONE_QUERY_GROUP_SIZE_POW2
+    output_group_offsets = (
+        output_query_len_idx * ONE_QUERY_GROUP_SIZE + output_group_idx_in_len
