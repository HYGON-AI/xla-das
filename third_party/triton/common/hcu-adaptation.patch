+def get_config_timings(config_timings, key_config):
+    dst = tuple((
+        *key_config.all_kwargs().items(),
+        key_config.pre_hook,
+    ))
+    for k, v in config_timings.items():
+        src = tuple((
+            *k.all_kwargs().items(),
+            k.pre_hook,
+        ))
+        if src == dst:
+            return v
+    return None
