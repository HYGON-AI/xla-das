+using ::mlir::LLVM::AMD::scaleDotElemTypeToMLIRType;
+using ::mlir::LLVM::AMD::shuffleXor;
+using ::mlir::triton::gpu::AMDMfmaEncodingAttr;
+using ::mlir::triton::gpu::DotOperandEncodingAttr;
