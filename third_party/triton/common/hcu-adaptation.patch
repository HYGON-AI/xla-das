+        external = libdevice.exp2(x)
+    elif OP == "log":
+        builtin = tl.log(x)
+        external = libdevice.log(x)
+    elif OP == "log2":
+        builtin = tl.log2(x)
+        external = libdevice.log2(x)
+    elif OP == "sin":
+        builtin = tl.sin(x)
+        external = libdevice.sin(x)
