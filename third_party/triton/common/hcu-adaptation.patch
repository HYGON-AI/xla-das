+    #     local_base_ptr = tl.load(scatter_signal_bufs_ptr + cur_rank).to(tl.pointer_type(tl.int32))
+    #     while tl.atomic_cas(local_base_ptr + tile_id, world_size - 1, 0, scope="sys", sem="acquire") != (world_size - 1):
+    #         pass
