+
+def _pa_decode_ref_single_query(
+    query, key_cache, value_cache, context_lengths, block_tables, softmax_scale
+):
+    # query: [B, H_Q, D], key_cache: [NB, H_KV, D//x, BS, x], value_cache: [NB, H_KV, D, BS]
+    bsz, num_q_heads, head_dim = query.shape
+    num_kv_heads = key_cache.shape[1]
+    block_size = key_cache.shape[3]
+    group = num_q_heads // num_kv_heads
+    out = torch.empty_like(query)
+
+    for b in range(bsz):
+        ctx = int(context_lengths[b].item())
+        for h in range(num_q_heads):
+            kv_h = h // group
+            qv = query[b, h].float()
+            keys = []
+            vals = []
+            for t in range(ctx):
+                blk = int(block_tables[b, t // block_size].item())
+                off = t % block_size
+                k = key_cache[blk, kv_h, :, off, :].reshape(head_dim).float()
+                v = value_cache[blk, kv_h, :, off].float()
+                keys.append(k)
+                vals.append(v)
+            k_mat = torch.stack(keys, dim=0)
+            v_mat = torch.stack(vals, dim=0)
+            logits = (k_mat @ qv) * softmax_scale
+            probs = torch.softmax(logits, dim=0)
+            out[b, h] = (probs[:, None] * v_mat).sum(dim=0).to(out.dtype)
+
+    return out
+
+
+@pytest.mark.skipif(not torch.cuda.is_available(), reason="CUDA device is required")
