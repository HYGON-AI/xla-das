+@triton.jit
+def _upcast_mxfp4_tile_kernel(
+    out,
+    tensor,
+    scale,
+    stride_out_m,
+    stride_out_k,
+    stride_tensor_m,
+    stride_tensor_k,
+    stride_scale_m,
