+bool isLegacyHcuGfx9(StringRef archGen) {
+  return archGen == "gfx926" || archGen == "gfx928" ||
+         archGen == "gfx92a" || archGen == "gfx936";
+}
+
+void forceIeeeF32DotPrecision(ModuleOp module) {
+  module.walk([](tt::DotOp dotOp) {
+    auto aType = cast<RankedTensorType>(dotOp.getA().getType());
+    auto bType = cast<RankedTensorType>(dotOp.getB().getType());
+    if (dotOp.getInputPrecision() == InputPrecision::TF32 &&
+        aType.getElementType().isF32() && bType.getElementType().isF32()) {
+      dotOp->setAttr("inputPrecision",
+                     tt::InputPrecisionAttr::get(dotOp.getContext(),
+                                                 InputPrecision::IEEE));
+    }
+  });
+}
