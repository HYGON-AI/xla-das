+  // return cvtScalePkDowncastToFp8<ROCDL::CvtScaleF32PkBf8F32>(loc, rewriter,
+  //                                                            v[0], v[1]);
+  return HCU_cvtPkDowncastToFp8<ROCDL::HCUCvtPkBf8F32Op>(loc, rewriter,
+                                                         v[0], v[1]);
