+        aiter.dtypes.bf16,
+        aiter.dtypes.fp16,
+    ], f"output tensor only support dtype in [{aiter.dtypes.bf16, aiter.dtypes.fp16}], but got output.dtype == {output.dtype}"
+    assert (
