+    if M < BLOCK_SIZE_M or N < BLOCK_SIZE_N or K < BLOCK_SIZE_K:
+        pytest.skip(f"skip: [{M},{N},{K}] with BLOCK[{BLOCK_SIZE_M},{BLOCK_SIZE_N},{BLOCK_SIZE_K}]")
+
+    if (num_stages == 3 and async_copy_use_single_buffer):
