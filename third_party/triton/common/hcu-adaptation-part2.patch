+  patterns.add<MLSLocalAllocOpConversion,
+               MLSMatrixLoadToLocalOpConversion,
+               MLSLocalLoadOpConversion>(typeConverter, targetInfo,
+                                         axisInfoAnalysis, benefit);
+}
