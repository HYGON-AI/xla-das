+static ConverterT Fp32_to_Fp8E4M3FN_RTNE(amdgpu::ISAFamily isaFamily, bool capFP8F32) {
+  return capFP8F32 ? Fp32_to_Fp8E4M3FN_RTNE_HW : Fp32_to_Fp8E4M3FN_RTNE_SW;
+}
