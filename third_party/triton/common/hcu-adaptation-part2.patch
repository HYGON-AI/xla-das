+        "wdra_num_mma_regs": 100
+    }
+    print("accuracy test (fwd fp16) Z=%s Q_H=%s K_H=%s N_CTX=%s D_HEAD=%s causal=%s config=%s"
+          % (Z, Q_H, K_H, N_CTX, D_HEAD, causal, config))
