+    print(f"  矩阵大小: A[{M}, {K}] × B[{K}, {N}]")
+    print(f"  内核配置: {config}")
+    print(f"  混合加载: {mix_load}")
+    print(f"  边界检查: {boundary_check}")
+    print(f"  A scale: {with_a_scale}")
+    print(f"  B scale: {with_b_scale}")
+    print(f"  epilogue: {optimize_epilogue}")
