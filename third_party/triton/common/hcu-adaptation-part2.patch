+_swiglu_configs = [
+    triton.Config({'BLOCK_SIZE': BLOCK_SIZE}, num_warps=w) \
+    for BLOCK_SIZE in [4096, 8192, 16384, 32768]\
+    for w in [4, 8]\
+]
