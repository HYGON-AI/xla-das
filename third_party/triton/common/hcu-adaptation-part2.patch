-// fp8e4m3fnuz to bf16
-static SmallVector<Value>
-Fp8E4M3FNUZ_to_Bf16_HW(Location loc, ConversionPatternRewriter &rewriter,
-                       const SmallVector<Value> &v) {
-  assert(v.size() == 4);
-  auto ret = cvtPkF8ToFp32<ROCDL::CvtPkF32Fp8Op>(loc, rewriter, v);
