+                # Create mask for valid tokens
+                valid_token_mask = qk_column_offsets < context_length
+                # Mask out value_scale of invalid tokens
+                value_scale_value = tl.where(
+                    valid_token_mask, value_scale_value, float(0.0)
+                )
