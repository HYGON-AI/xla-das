+static SmallVector<Value>
+Bf16_to_Fp8E4M3FN_RTNE_SW(Location loc, ConversionPatternRewriter &rewriter,
+                          const SmallVector<Value> &v) {
+
+  assert(v.size() == 2);
+  SmallVector<Value> result(2);
+  for (size_t i = 0; i < 2; ++i)
