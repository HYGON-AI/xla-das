+        & (mtp_query_group_size_offsets[None, :, None] < ONE_QUERY_GROUP_SIZE)
+        & (mtp_head_size_offsets[None, None, :] < head_size)
+    )
+    mtp_query_tensor = gl.amd.cdna3.buffer_load(
