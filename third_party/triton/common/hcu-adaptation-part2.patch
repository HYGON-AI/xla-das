+    auto rhsElemTy = getElementTypeOrSelf(op.getRhs());
+    if (lhsElemTy.isBF16() && rhsElemTy.isBF16()) {
+      return {EmitDualBF16ElementwiseOp<LLVM::FSubOp>(loc, rewriter, operands,
+                                                      capBF16F32)};
+    } else {
