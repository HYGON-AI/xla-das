+    bf16 = torch.bfloat16
+    fp16 = torch.float16
+    fp32 = torch.float32
+
+
+class _AiterShim:
+    dtypes = _Dtypes
+
+
+aiter = _AiterShim()
+arch_info = _ArchInfo()
