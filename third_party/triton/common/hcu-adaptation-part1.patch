+  return LinearLayout({{kVec, unflatten(keptVec)},
+                       {kBank, unflatten(bank)},
+                       {kSegment, unflatten(segment)},
+                       {kBlock, unflatten(block)},
+                       {kReps, unflatten(reps)}},
+                      smem.getOutDims(), /*requireSurjective=*/true);
