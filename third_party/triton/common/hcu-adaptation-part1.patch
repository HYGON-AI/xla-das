+
+  # =====================
+  # run googletest cases
+  # =====================
+  run_google_test
+
+  # =====================
+  # run lit cases
+  # =====================
+  run_lit 0
+}
+
+source ${CUR_PATH}/launch.sh
+
+build_llvm
+clean_cache
+build_triton
+regression_for_test
