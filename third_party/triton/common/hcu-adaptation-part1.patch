-  SmallVector<Value> vec(4);
-  vec[0] = f16Vec[0];
-  vec[1] = f16Vec[1];
-  inVals[0] = v[2];
-  inVals[1] = v[3];
-  f16Vec = convertFp32ToFp16RTZ(loc, rewriter, inVals);
-  vec[2] = f16Vec[0];
-  vec[3] = f16Vec[1];
