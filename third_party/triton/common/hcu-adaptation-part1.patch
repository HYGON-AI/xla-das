-    if constexpr (std::is_same_v<FPType, Float8E4M3FNUZType>) {
-      return llvm::APFloat::Float8E4M3FNUZ();
-    }
-    if constexpr (std::is_same_v<FPType, Float8E5M2FNUZType>) {
-      return llvm::APFloat::Float8E5M2FNUZ();
