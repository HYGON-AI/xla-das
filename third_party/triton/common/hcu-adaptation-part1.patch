+        if (prev && isa<ROCDL::SetPrioOp>(prev))
+          prev = prev->getPrevNode();
+        if (!isa_and_nonnull<scf::ForOp>(prev)) {
+          LDBG("post-loop cond_barrier not preceded by scf.for; skipping");
+          continue;
+        }
+        auto prevFor = cast<scf::ForOp>(prev);
