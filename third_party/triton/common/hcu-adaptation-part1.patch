+// Pass Definition
+//===----------------------------------------------------------------------===//
+
+namespace mlir::triton::gpu {
+#define GEN_PASS_DEF_TRITONGPUPARTITIONSCHEDULINGHCU
+#include "triton/Dialect/TritonGPU/Transforms/Passes.h.inc"
+} // namespace mlir::triton::gpu
+
+namespace {
+struct PartitionScheduling
+    : public triton::gpu::impl::TritonGPUPartitionSchedulingHCUBase<
+          PartitionScheduling> {
+  using TritonGPUPartitionSchedulingHCUBase::TritonGPUPartitionSchedulingHCUBase;
+
+  void runOnOperation() override;
+};
+} // namespace
+
+void PartitionScheduling::runOnOperation() {
+  SmallVector<scf::ForOp> loops;
+  getOperation().walk([&](scf::ForOp loop) {
+    if (loop->hasAttr(kWarpSpecializeAttrName))
+      loops.push_back(loop);
+  });
+  for (auto [idx, loop] : llvm::enumerate(loops)) {
+    if (std::optional<WarpSchedule> schedule = getInitialSchedule(loop)) {
+      mlir::triton::gpu::hcu::propagatePartitions(loop, *schedule);
+      mlir::triton::gpu::hcu::optimizeSchedule(loop, *schedule);
+      schedule->serialize(loop);
+      loop->setAttr(
+          kWarpSpecializeTagAttrName,
+          IntegerAttr::get(IntegerType::get(loop.getContext(), 32), idx));
+    }
+  }
+}
