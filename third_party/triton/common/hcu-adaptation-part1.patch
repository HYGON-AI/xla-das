+  SmallVector<BlockInfo> mergedInfo;
+  for (auto *b : loopBlocks)
+    mergedInfo.push_back(buildBlockInfoFromBlock(b, allocation));
+  for (auto *b : nextBlocks)
+    mergedInfo.push_back(buildBlockInfoFromBlock(b, allocation));
