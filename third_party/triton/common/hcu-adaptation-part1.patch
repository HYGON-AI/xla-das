+    kk_re=[]
+    vv_re=[]
+    for i in range(K_H):
+        k_c = k[:,i:i+1,:,:]
+        m_k_c = k_c.repeat(1, q_num_per_group,1,1)
+        kk_re.append(m_k_c)
+        v_c = v[:,i:i+1,:,:]
+        m_v_c = v_c.repeat(1, q_num_per_group,1,1)
+        vv_re.append(m_v_c)
+    kk=torch.cat(kk_re,dim=1)
+    vv=torch.cat(vv_re,dim=1)
