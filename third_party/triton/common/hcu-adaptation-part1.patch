-  // Convert fp8 to fp32
-  SmallVector<Value> ret =
-      cvtPkF8ToFp32<ROCDL::CvtPkF32Fp8Op>(loc, rewriter, v);
-
-  // Convert fp32 to fp16
-  for (size_t i = 0; i < 4; i++)
