+        # offs_cm = target_m + tl.arange(0, BLOCK_SIZE_M)
+        offs_cn = pid_n * BLOCK_SIZE_N + tl.arange(0, BLOCK_SIZE_N)
+
+        # # Modif: get scatter buffer ptr
+        dtype = a_ptr.dtype.element_ty
