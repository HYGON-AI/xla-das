+ *
+ * Detect below pattern:
+ *   %mask = ...                    (block layout)
+ *   %x = matrix_load               (dot layout)
+ *   %pred = convert_layout %mask   (block -> dot layout)
+ *   %z = select %pred, %x, %others (dot layout)
