-                       const SmallVector<Value> &v) {
-  assert(v.size() == 4);
-  SmallVector<Value> result(4);
-  for (size_t i = 0; i < 4; i++)
-    result[i] = Fp8E4M3FNUZ_to_Fp16_oneValue(loc, rewriter, v[i]);
-  return result;
-}
