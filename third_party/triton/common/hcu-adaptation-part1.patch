+  SmallVector<StringAttr> otherInDims;
+  for (StringAttr inDim : getInDimNames()) {
+    if (inDim != dim)
+      otherInDims.push_back(inDim);
+  }
+  return squareSublayoutIsIdentity(*this, {dim}) &&
+         sublayoutIsZero(otherInDims, {dim});
