+std::unique_ptr<OperationPass<ModuleOp>>
+mlir::triton::createConvertAMDDistributedToLLVMPass(StringRef targetArch,
+                                                    bool ftz) {
+  return std::make_unique<ConvertAMDDistributedToLLVM>(targetArch, ftz);
+}
