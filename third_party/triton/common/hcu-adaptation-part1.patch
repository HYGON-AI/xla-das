+def triton_gemm_allreduce(
+    a, b,
+    output,
+    scatter_bufs_ptr,
+    scatter_signal_bufs_ptr,
+    sync_bufs_ptr,
+    rank, num_ranks, M, N, K,
+    BLK_M: int,
+    BLK_N: int,
+    BLK_K: int,
+    gsize_m: int,
+    num_sms,
+    current_stream,
+    scatter_stream
+):
+    # barrier_all_on_stream(rank, num_ranks, scatter_signal_bufs_ptr, current_stream)
